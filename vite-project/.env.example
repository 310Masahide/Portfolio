# このファイルを `vite-project/.env` にコピーし、各キーに値を設定してください（`.env` は Git に含めません）。
#
# `vite.config.ts` の loadEnv が開発サーバー起動時に読み込み、/api/gemini・/api/openai のプロキシで使用します。
# いずれもクライアントバンドルには載りません（サーバー側のみ）。

# Gemini API キー（振り返りの「AIに俯瞰してもらう」→ /api/gemini）
# 取得: https://ai.google.dev/
GEMINI_API_KEY=
# 互換用（サーバーは GEMINI_API_KEY を優先。未設定のときのみ参照）
# 新規プロジェクトでは GEMINI_API_KEY のみで十分です。
VITE_GEMINI_API_KEY=

# OpenAI API キー（/api/openai。GPT 連携を使う場合に必要）
# 取得: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 以下は任意。未設定時は server/devAiProxyUpstream.ts の既定値を使用します。
# エンドポイントやモデル変更は .env のみで切り替え可能です。
GEMINI_API_URL=
OPENAI_API_URL=
OPENAI_MODEL=
